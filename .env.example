# StudyPilot environment template.
# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# Telegram bot and Mini App
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=your_studypilot_bot
WEBAPP_URL=https://miniapp.example.com
AI_ADMIN_TELEGRAM_ID=

# Internal service authentication. Generate two long independent random values.
APP_SECRET=CHANGE_ME_LONG_RANDOM_APP_SECRET
INTERNAL_API_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN

# AI provider. Supported: polza, gemini, openai, openrouter, anthropic, local.
AI_PROVIDER=polza
POLZA_API_KEY=CHANGE_ME_POLZA_API_KEY
POLZA_BASE_URL=https://polza.ai/api/v1

# Generic OpenAI-compatible provider settings (leave empty when Polza is used).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=deepseek/deepseek-v4-pro
AI_ANALYSIS_MODEL=

# StudyPilot model routing: Flash for background/simple work, Pro for complex work.
AI_PRIMARY_MODEL=deepseek/deepseek-v4-pro
AI_BACKGROUND_MODEL=deepseek/deepseek-v4-flash
AI_EMBEDDING_MODEL=baai/bge-m3
AI_DEFAULT_MODE=auto
AI_ENABLED=true
AI_BACKGROUND_ENABLED=true

# Optional Gemini fallback for audio/media workflows.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI batching, context and provider request controls.
AI_BATCH_SIZE=20
AI_BATCH_MAX_WAIT_SECONDS=90
AI_CONTEXT_CHAR_LIMIT=30000
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_REQUESTS_PER_MINUTE=30
AGENT_MAX_TOOL_CALLS=5

# Application-wide, per-user and background usage limits.
AI_MONTHLY_TOKEN_LIMIT=1000000
AI_USER_MONTHLY_TOKEN_LIMIT=250000
AI_BACKGROUND_MONTHLY_TOKEN_LIMIT=500000
AI_MONTHLY_COST_LIMIT_RUB=500
AI_MONTHLY_REQUEST_LIMIT=10000
AI_USER_MONTHLY_REQUEST_LIMIT=2000
AI_BACKGROUND_MONTHLY_REQUEST_LIMIT=5000

# Message processing and retention.
MAX_ATTACHMENT_BYTES=10485760
MESSAGE_RETENTION_DAYS=365

# MySQL used by Docker Compose. Replace passwords before any shared deployment.
MYSQL_DATABASE=studypilot
MYSQL_USER=studypilot
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PORT=3307

# Local non-Docker database URL. Docker Compose overrides DATABASE_URL for backend/bot.
DATABASE_URL=mysql+pymysql://studypilot:CHANGE_ME_MYSQL_PASSWORD@localhost:3307/studypilot?charset=utf8mb4

# Internal service URLs.
API_BASE_URL=http://backend:8000
VITE_API_URL=http://localhost:8000

# Development authentication MUST stay false in public environments.
DEV_AUTH=false
VITE_DEV_AUTH=false
VITE_DEV_TELEGRAM_ID=

# Locale and schedule parity.
DEFAULT_TIMEZONE=Europe/Moscow
# Any date inside an odd study week (YYYY-MM-DD); empty uses the September default.
ODD_WEEK_REFERENCE=
